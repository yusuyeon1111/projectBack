# 인증서는 Caddy가 자동으로 받고 갱신한다(80·443이 열려 있고 도메인이 이 서버를 가리켜야 한다)
# kro.kr은 여러 사람이 나눠 쓰는 도메인이라 Let's Encrypt의 상위 도메인당 주간 발급 한도(50장)가 늘 차 있다.
# 계정 이메일이 있으면 Caddy가 Let's Encrypt 실패 시 ZeroSSL(무료 ACME)로 넘어가 받는다
{
	email {$ACME_EMAIL}
}

{$DOMAIN:teamhaeyo.kro.kr} {
	encode zstd gzip

	# SSE(text/event-stream)는 Caddy가 버퍼링 없이 바로 흘려보낸다
	# /oauth2/success는 토큰을 받는 프론트 화면이라 백엔드로 보내면 안 된다. 로그인 시작·콜백만 백엔드로
	@backend path /api/* /oauth2/authorization/* /login/oauth2/*
	handle @backend {
		reverse_proxy app:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
