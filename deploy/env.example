# deploy/.env 로 복사해 채운다(cp env.example .env). .env는 git에 올리지 않는다.
# 비밀값 만들기: openssl rand -base64 24  (JWT_SECRET은 openssl rand -base64 32)
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
JWT_SECRET=
# 카카오 REST API 키(백엔드 로그인), JavaScript 키(프론트 지도, 빌드 시 박힘)
KAKAO_CLIENT_ID=
REACT_APP_KAKAO_API_KEY=
# 비워 두면 네이버 로그인만 동작하지 않는다
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
AWS_S3_BUCKET_NAME=teamhaeyo-files-830283279722
